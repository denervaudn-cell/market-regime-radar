# Choose exactly one private server-side snapshot source.
# Local paths are not packaged/deployed by .vercelignore.
RADAR_DATASET_PATH=/absolute/path/to/radar.json
# RADAR_DATASET_URL=https://your-internal-distribution/radar/latest.json
# RADAR_DATASET_TOKEN=server-side-distribution-token

# Only for retained root Node compatibility handlers, not the Python app:
# RADAR_PYTHON_API_URL=http://127.0.0.1:8000

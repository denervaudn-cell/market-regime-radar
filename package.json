{
  "name": "market-regime-radar",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run uvicorn app:app --reload --host 127.0.0.1 --port 8000",
    "dev:mock": "RADAR_DATA_MODE=mock uv run uvicorn app:app --reload --host 127.0.0.1 --port 8000",
    "test": "uv run pytest",
    "test:ui": "playwright test",
    "test:legacy": "node --test tests/legacy.test.js",
    "check": "uv run ruff check . && uv run ruff format --check . && node --check static/app.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
